{
  "name": "quiet-workshop",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "description": "A calming 3D restoration game: seasonal places to clean, repair and bring back to life.",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4188",
    "build": "vite build && node scripts/artifacts.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4188",
    "test": "node --test tests/*.test.mjs",
    "build:landing": "node scripts/build-landing.mjs",
    "publish:landing": "node scripts/publish-landing.mjs --hosting-receipt config/hosting.json",
    "verify:landing": "node scripts/verify-landing.mjs"
  },
  "dependencies": {
    "three": "0.185.1",
    "@dimforge/rapier3d-compat": "0.12.0"
  },
  "devDependencies": {
    "vite": "7.3.6"
  },
  "engines": {
    "node": ">=22"
  }
}
